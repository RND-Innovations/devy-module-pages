{% extends "@Admin/layouts/admin.twig" %}

{% set _page = 'admin.pages.list' %}

{% block content %}

<!-- HEADER -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

    <!-- LEFT -->
<div class="flex items-center gap-2 flex-wrap">

    <!-- ROOT -->
    <a href="{{ routes.list }}"
       class="flex items-center gap-1 text-sm bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-lg">
        {{ icon('home')|raw }}
    </a>

    {% if current_path %}

        {% set parts = current_path|split('/') %}
        {% set build = '' %}

        {% set parent = parts|length > 1 ? parts|slice(0, -1)|join('/') : '' %}

        <!-- BREADCRUMB -->
        {% for part in parts %}

            {% if part|length > 0 %}

                {% set build = build ~ '/' ~ part %}

                <span class="text-gray-400">/</span>

                <a href="{{ routes.list }}/view/{{ build|trim('/') }}"
                   class="text-sm px-2 py-1 rounded-md hover:bg-gray-100">
                    {{ part }}
                </a>

            {% endif %}

        {% endfor %}

    {% endif %}

</div>

    <!-- RIGHT -->
    <div class="flex items-center gap-2">

        <a href="{{ routes.create }}"
           class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow">
            {{ icon('add')|raw }} Add Page
        </a>

    </div>

</div>

<!-- EMPTY STATE -->
<!-- EMPTY STATE -->
{% if items is empty %}
    <div class="flex flex-col items-center justify-center text-center py-20 text-gray-500">

        <!-- ICON -->
        <div class="mb-4 text-gray-300">
            {{ icon('info', 'w-[6rem] h-[6rem]')|raw }}
        </div>

        <!-- TITLE -->
        <h3 class="text-lg font-semibold text-gray-700 mb-1">
            Nothing here yet
        </h3>

        <!-- DESCRIPTION -->
        <p class="text-sm">
            No pages or categories in this folder.
        </p>

        <!-- ACTION -->
        <a href="{{ routes.create }}"
           class="mt-5 inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow">
            
            {{ icon('add', 'w-4 h-4')|raw }}
            Create Page
        </a>

    </div>
{% endif %}

<!-- GRID -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">

{% for item in items %}
    <div class="bg-white border rounded-xl p-4 shadow-sm hover:shadow-lg transition">

        <!-- TOP BAR -->
        <div class="flex items-center justify-between mb-2">

            {% if item.type == 'folder' %}
                <span class="text-xs px-2 py-1 rounded bg-yellow-100 text-yellow-700 flex items-center gap-1">
                    {{ icon('folder')|raw }} Category
                </span>
            {% else %}
                <span class="text-xs px-2 py-1 rounded bg-blue-100 text-blue-700 flex items-center gap-1">
                    {{ icon('file')|raw }} Page
                </span>
            {% endif %}

        </div>

        <!-- TITLE -->
        <h3 class="font-semibold text-lg truncate">
            {{ item.title }}
        </h3>

        <!-- PATH -->
        <p class="text-xs text-gray-400 mb-3 truncate">
            /{{ item.path }}
        </p>

        <!-- ACTIONS -->
        <div class="flex flex-wrap gap-2">

            <!-- Manage -->
            <a class="flex items-center gap-1 text-sm bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded"
               href="{{ routes.list }}/view/{{ item.path }}">
               {{ icon('open')|raw }} Open
            </a>

            <!-- Edit -->
            <a class="flex items-center gap-1 text-sm bg-blue-100 hover:bg-blue-200 text-blue-700 px-2 py-1 rounded"
               href="{{ routes.list }}/edit/{{ item.path }}">
               {{ icon('edit')|raw }} Edit
            </a>

            <!-- Preview -->
            <a class="flex items-center gap-1 text-sm bg-green-100 hover:bg-green-200 text-green-700 px-2 py-1 rounded"
               href="{{ routes.view }}?path={{ item.path }}"
               target="_blank">
               {{ icon('eye')|raw }} View
            </a>

        </div>

    </div>
{% endfor %}

</div>

{% endblock %}
